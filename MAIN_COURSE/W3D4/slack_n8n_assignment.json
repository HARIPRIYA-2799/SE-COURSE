    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  // 1. Extract the text from the previous LLM node\n  let rawText = item.json.text || \"\";\n\n  // 2. Handle any escaped newlines\n  let cleanedText = rawText.replace(/\\\\n/g, '\\n').trim();\n\n  // 3. Convert markdown dashes or asterisks to proper Slack bullet points (•)\n  // This looks for spaces/tabs followed by a dash or asterisk, then more spaces\n  cleanedText = cleanedText.replace(/^[ \\t]*[-*][ \\t]+/gm, '• ');\n\n  // 4. Output a clean JSON object containing the formatted text\n  results.push({\n    json: {\n      text: cleanedText\n    }\n  });\n}\n\nreturn results;"
      },
